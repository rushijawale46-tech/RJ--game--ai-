<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title>RJ Game India</title>

<link rel="manifest" href="./manifest.webmanifest">

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
  background:#02040a;
  color:white;
  font-family:Arial,Helvetica,sans-serif;
}

button{
  border:0;
  border-radius:12px;
  padding:12px 18px;
  margin:5px;
  font-weight:800;
  color:white;
  background:linear-gradient(145deg,#182b48,#07101d);
  box-shadow:0 5px 18px #0009;
}

button:active{
  transform:scale(.95);
}

#loading{
  position:fixed;
  inset:0;
  z-index:100;
  background:
    radial-gradient(circle at 50% 30%,#183d63,#03050b 65%);
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
}

.loadingBox{
  width:min(92vw,700px);
  padding:25px;
}

.logo{
  font-size:clamp(34px,8vw,70px);
  font-weight:1000;
  letter-spacing:3px;
  text-shadow:0 0 25px #1e9cff;
}

.subtitle{
  color:#8fd4ff;
  font-weight:bold;
  margin:8px;
}

.loadingImage{
  width:min(90vw,500px);
  max-height:46vh;
  object-fit:contain;
  border-radius:22px;
  box-shadow:0 0 35px #0077ff66;
}

.loadingTrack{
  height:15px;
  background:#111b28;
  border-radius:20px;
  margin-top:20px;
  overflow:hidden;
}

#loadingProgress{
  width:0%;
  height:100%;
  background:linear-gradient(90deg,#00aaff,#fff,#00aaff);
  box-shadow:0 0 20px #00aaff;
}

#loadingPercent{
  margin-top:8px;
  font-weight:bold;
}

#app{
  display:none;
  position:fixed;
  inset:0;
}

#menu{
  position:absolute;
  inset:0;
  overflow:auto;
  padding:18px;
  background:
    radial-gradient(circle at 50% 0%,#12365b,#03060b 70%);
}

.header{
  text-align:center;
  padding:12px;
}

.header h1{
  margin:0;
  font-size:clamp(30px,7vw,55px);
  text-shadow:0 0 25px #168fff;
}

.header p{
  color:#9bdcff;
}

.menuGrid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(145px,1fr));
  gap:12px;
  max-width:850px;
  margin:20px auto;
}

.menuCard{
  min-height:100px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  cursor:pointer;
  background:linear-gradient(145deg,#102945,#07101b);
  border:1px solid #24557d;
  border-radius:18px;
  font-size:17px;
  font-weight:900;
  box-shadow:0 8px 25px #0008;
}

.menuCard:hover{
  border-color:#38b8ff;
  box-shadow:0 0 25px #008cff55;
}

#stadiumMenu,
#teamMenu,
#xiMenu,
#auctionMenu,
#careerMenu{
  display:none;
  position:absolute;
  inset:0;
  overflow:auto;
  padding:20px;
  background:#040810;
  z-index:30;
}

.panel{
  max-width:950px;
  margin:auto;
  background:linear-gradient(145deg,#0b1828,#03070d);
  border:1px solid #1b4264;
  border-radius:20px;
  padding:18px;
}

.panel h2{
  margin-top:0;
}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
  gap:12px;
}

.card{
  background:#0c1725;
  border:1px solid #204563;
  border-radius:16px;
  padding:12px;
  text-align:center;
}

.stadiumVisual{
  height:110px;
  border-radius:12px;
  margin-bottom:10px;
  background:
    radial-gradient(ellipse,#0a8a3d 0 25%,#c8b06c 26% 31%,#168347 32% 53%,#15283b 54% 70%,#080d15 71%);
  box-shadow:inset 0 0 30px #000;
}

.playerAvatar{
  width:75px;
  height:75px;
  margin:auto;
  border-radius:50%;
  object-fit:cover;
  background:
    radial-gradient(circle at 50% 30%,#d7a477 0 25%,transparent 26%),
    linear-gradient(#172b42 0 55%,#0b1118 56%);
  border:2px solid #4ba9df;
}

.playerName{
  font-weight:900;
  margin-top:8px;
}

.rating{
  color:#ffd65c;
  font-weight:bold;
}

#game{
  position:absolute;
  inset:0;
  display:none;
  background:#020509;
}

#three{
  position:absolute;
  inset:0;
}

#hud{
  position:absolute;
  top:8px;
  left:8px;
  right:8px;
  display:flex;
  justify-content:space-between;
  gap:8px;
  z-index:10;
  pointer-events:none;
}

.hudBox{
  background:#020611d9;
  border:1px solid #41769a;
  border-radius:12px;
  padding:8px 12px;
  backdrop-filter:blur(8px);
  font-weight:bold;
}

#score{
  font-size:18px;
}

#controls{
  position:absolute;
  left:0;
  right:0;
  bottom:8px;
  z-index:15;
  text-align:center;
  padding:5px;
}

.controlRow{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:2px;
}

.controlBtn{
  min-width:75px;
  font-size:12px;
}

.power{
  background:linear-gradient(145deg,#a32121,#350708);
}

#commentary{
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  bottom:125px;
  width:min(90vw,650px);
  padding:10px 15px;
  text-align:center;
  background:#02050bd9;
  border:1px solid #3c7297;
  border-radius:15px;
  z-index:12;
  font-weight:bold;
}

#tracer{
  position:absolute;
  inset:0;
  z-index:9;
  pointer-events:none;
}

#replayPanel{
  display:none;
  position:absolute;
  top:70px;
  right:10px;
  z-index:20;
  padding:12px;
  background:#02050be8;
  border:1px solid #48a5db;
  border-radius:14px;
}

.back{
  margin-bottom:15px;
}

.small{
  font-size:12px;
  color:#9eb9ca;
}

.badge{
  display:inline-block;
  padding:4px 8px;
  border-radius:8px;
  background:#143e5b;
  margin:3px;
  font-size:11px;
}

@media(max-width:600px){
  #commentary{
    bottom:118px;
    font-size:12px;
  }

  .controlBtn{
    min-width:65px;
    padding:9px 7px;
    font-size:11px;
  }
}
</style>
</head>

<body>

<!-- ================= LOADING SCREEN ================= -->

<div id="loading">

  <div class="loadingBox">

    <div class="logo">RJ GAME INDIA</div>

    <div class="subtitle">
      REALISTIC CRICKET • 3D • INDIA
    </div>

    <img
      class="loadingImage"
      src="./virat-kohli.png"
      alt="RJ Game India"
      onerror="this.style.display='none'"
    >

    <div class="loadingTrack">
      <div id="loadingProgress"></div>
    </div>

    <div id="loadingPercent">0%</div>

    <div class="small">
      Playing XI • IPL Auction • Career Mode • Replay • Weather
    </div>

  </div>

</div>


<!-- ================= APP ================= -->

<div id="app">

<!-- ================= MAIN MENU ================= -->

<section id="menu">

  <div class="header">
    <h1>🏏 RJ GAME INDIA</h1>
    <p>REALISTIC 3D CRICKET • VERSION 1.0.0</p>
  </div>

  <div class="menuGrid">

    <div class="menuCard" onclick="openStadiums()">
      🏟️<br>STADIUM
    </div>

    <div class="menuCard" onclick="openTeams()">
      🇮🇳<br>TEAMS
    </div>

    <div class="menuCard" onclick="openXI()">
      👥<br>PLAYING XI
    </div>

    <div class="menuCard" onclick="startMatch()">
      🏏<br>QUICK MATCH
    </div>

    <div class="menuCard" onclick="openAuction()">
      💰<br>IPL AUCTION
    </div>

    <div class="menuCard" onclick="openCareer()">
      🏆<br>CAREER MODE
    </div>

    <div class="menuCard" onclick="alert('Controls: POWER SHOT • SWING • DEFEND • RUN • BOWL')">
      🎮<br>CONTROLS
    </div>

    <div class="menuCard" onclick="alert('Hindi Live Commentary: ON\\nVolume: 80%')">
      🎙️<br>COMMENTARY
    </div>

  </div>

  <div class="panel">

    <h2>🔥 Game Features</h2>

    <span class="badge">3D Stadium</span>
    <span class="badge">Animated Crowd</span>
    <span class="badge">Dynamic Lights</span>
    <span class="badge">Shot Tracer</span>
    <span class="badge">Replay</span>
    <span class="badge">Multi Camera</span>
    <span class="badge">Dynamic Weather</span>
    <span class="badge">Strong AI</span>
    <span class="badge">IPL</span>
    <span class="badge">Test</span>
    <span class="badge">ODI</span>
    <span class="badge">T20</span>
    <span class="badge">Career</span>
    <span class="badge">Auction</span>

  </div>

</section>


<!-- ================= STADIUM ================= -->

<section id="stadiumMenu">

  <div class="panel">

    <button class="back" onclick="closePanels()">← BACK</button>

    <h2>🏟️ SELECT STADIUM</h2>

    <div class="cards">

      <div class="card" onclick="selectStadium('Wankhede Stadium')">
        <div class="stadiumVisual"></div>
        <b>Wankhede Stadium</b>
        <p class="small">Mumbai • India</p>
      </div>

      <div class="card" onclick="selectStadium('M. Chinnaswamy Stadium')">
        <div class="stadiumVisual"></div>
        <b>M. Chinnaswamy Stadium</b>
        <p class="small">Bengaluru • India</p>
      </div>

      <div class="card" onclick="selectStadium('Arun Jaitley Stadium')">
        <div class="stadiumVisual"></div>
        <b>Arun Jaitley Stadium</b>
        <p class="small">Delhi • India</p>
      </div>

      <div class="card" onclick="selectStadium('Perth Stadium')">
        <div class="stadiumVisual"></div>
        <b>Perth Stadium</b>
        <p class="small">Perth • Australia</p>
      </div>

    </div>

  </div>

</section>


<!-- ================= TEAMS ================= -->

<section id="teamMenu">

  <div class="panel">

    <button class="back" onclick="closePanels()">← BACK</button>

    <h2>🌍 TEAMS</h2>

    <div class="cards" id="teamCards"></div>

  </div>

</section>


<!-- ================= PLAYING XI ================= -->

<section id="xiMenu">

  <div class="panel">

    <button class="back" onclick="closePanels()">← BACK</button>

    <h2>👥 INDIA PLAYING XI</h2>

    <div class="cards" id="xiCards"></div>

  </div>

</section>


<!-- ================= AUCTION ================= -->

<section id="auctionMenu">

  <div class="panel">

    <button class="back" onclick="closePanels()">← BACK</button>

    <h2>💰 IPL AUCTION</h2>

    <p>Team Purse: ₹<span id="purse">100</span> Cr</p>

    <div class="cards" id="auctionCards"></div>

  </div>

</section>


<!-- ================= CAREER ================= -->

<section id="careerMenu">

  <div class="panel">

    <button class="back" onclick="closePanels()">← BACK</button>

    <h2>🏆 CAREER MODE</h2>

    <div class="card">

      <h3>RJ Player Career</h3>

      <p>Matches: <b id="careerMatches">0</b></p>
      <p>Runs: <b id="careerRuns">0</b></p>
      <p>Wickets: <b id="careerWickets">0</b></p>
      <p>Rating: ⭐ 80</p>

      <button onclick="alert('Career match started!')">
        START CAREER MATCH
      </button>

    </div>

  </div>

</section>


<!-- ================= GAME ================= -->

<section id="game">

  <div id="three"></div>

  <canvas id="tracer"></canvas>

  <div id="hud">

    <div class="hudBox">
      <div id="teamScore">IND 0/0</div>
      <div class="small" id="overs">0.0 Overs</div>
    </div>

    <div class="hudBox">
      <div id="stadiumName">Wankhede Stadium</div>
      <div class="small" id="weather">☀️ Clear</div>
    </div>

  </div>

  <div id="commentary">
    🎙️ Match starting... RJ Game India live commentary.
  </div>

  <div id="replayPanel">

    <b>🎥 REPLAY CAMERA</b><br>

    <button onclick="cameraMode('BROADCAST')">BROADCAST</button>
    <button onclick="cameraMode('BATTER')">BATTER</button>
    <button onclick="cameraMode('BOWLER')">BOWLER</button>
    <button onclick="cameraMode('BALL')">BALL</button>

  </div>

  <div id="controls">

    <div class="controlRow">

      <button class="controlBtn power"
              onclick="playShot('POWER SHOT')">
        POWER SHOT
      </button>

      <button class="controlBtn"
              onclick="playShot('SWING')">
        SWING
      </button>

      <button class="controlBtn"
              onclick="playShot('DEFEND')">
        DEFEND
      </button>

      <button class="controlBtn"
              onclick="runBetweenWickets()">
        RUN
      </button>

      <button class="controlBtn"
              onclick="bowlBall()">
        BOWL
      </button>

      <button class="controlBtn"
              onclick="toggleReplay()">
        REPLAY
      </button>

      <button class="controlBtn"
              onclick="changeWeather()">
        WEATHER
      </button>

      <button class="controlBtn"
              onclick="cycleCamera()">
        CAMERA
      </button>

      <button class="controlBtn"
              onclick="backToMenu()">
        MENU
      </button>

    </div>

  </div>

</section>

</div>


<!-- ================= THREE.JS ================= -->

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>

/* =========================================================
   RJ GAME INDIA
   COMBINED 3D CRICKET PROTOTYPE
========================================================= */

let selectedStadium = "Wankhede Stadium";
let selectedTeam = "India";

let runs = 0;
let wickets = 0;
let balls = 0;

let weatherIndex = 0;
let cameraIndex = 0;

const weatherList = [
  "☀️ Clear",
  "☁️ Cloudy",
  "🌧️ Rain",
  "🌙 Night"
];

const stadiums = [
  "Wankhede Stadium",
  "M. Chinnaswamy Stadium",
  "Arun Jaitley Stadium",
  "Perth Stadium"
];

const internationalTeams = [
  "India",
  "Australia",
  "England",
  "Pakistan",
  "South Africa",
  "New Zealand",
  "Sri Lanka",
  "Bangladesh",
  "Afghanistan",
  "West Indies",
  "Zimbabwe",
  "Ireland"
];


/* ================= PLAYERS ================= */

const indiaXI = [

  ["Rohit Sharma","BAT","90"],
  ["Shubman Gill","BAT","89"],
  ["Virat Kohli","BAT","96","./virat-kohli.png"],
  ["Shreyas Iyer","BAT","87"],
  ["KL Rahul","WK-BAT","88"],
  ["Ravindra Jadeja","AR","91"],
  ["Hardik Pandya","AR","90"],
  ["Jasprit Bumrah","BOWL","97"],
  ["Kuldeep Yadav","BOWL","88"],
  ["Mohammed Siraj","BOWL","86"],
  ["Arshdeep Singh","BOWL","85"]

];

const auctionPlayers = [

  ["Virat Kohli","RCB",18],
  ["Jasprit Bumrah","MI",18],
  ["Rohit Sharma","MI",16],
  ["Ravindra Jadeja","RR",14],
  ["Hardik Pandya","MI",15],
  ["KL Rahul","DC",14],
  ["Shubman Gill","GT",14],
  ["Rishabh Pant","LSG",16],
  ["Suryakumar Yadav","MI",15],
  ["Yashasvi Jaiswal","RR",14],
  ["Jasprit Bumrah","MI",18],
  ["Ravindra Jadeja","RR",14]

];


/* ================= LOADING ================= */

let load = 0;

const loadingTimer = setInterval(() => {

  load++;

  document.getElementById("loadingProgress").style.width =
    load + "%";

  document.getElementById("loadingPercent").textContent =
    load + "%";

  if(load >= 100){

    clearInterval(loadingTimer);

    setTimeout(() => {

      document.getElementById("loading").style.display =
        "none";

      document.getElementById("app").style.display =
        "block";

    },500);

  }

},25);


/* ================= PANELS ================= */

function closePanels(){

  document.getElementById("stadiumMenu").style.display="none";
  document.getElementById("teamMenu").style.display="none";
  document.getElementById("xiMenu").style.display="none";
  document.getElementById("auctionMenu").style.display="none";
  document.getElementById("careerMenu").style.display="none";

  document.getElementById("menu").style.display="block";
}

function openStadiums(){

  document.getElementById("menu").style.display="none";
  document.getElementById("stadiumMenu").style.display="block";

}

function openTeams(){

  document.getElementById("menu").style.display="none";
  document.getElementById("teamMenu").style.display="block";

  const box = document.getElementById("teamCards");

  box.innerHTML="";

  internationalTeams.forEach(team => {

    box.innerHTML += `
      <div class="card">
        <h3>${team}</h3>
        <p>International Team</p>
        <button onclick="chooseTeam('${team}')">
          SELECT
        </button>
      </div>
    `;

  });

}

function openXI(){

  document.getElementById("menu").style.display="none";
  document.getElementById("xiMenu").style.display="block";

  const box = document.getElementById("xiCards");

  box.innerHTML="";

  indiaXI.forEach(player => {

    let image = player[3]
      ? `<img class="playerAvatar" src="${player[3]}" alt="${player[0]}">`
      : `<div class="playerAvatar"></div>`;

    box.innerHTML += `

      <div class="card">

        ${image}

        <div class="playerName">
          ${player[0]}
        </div>

        <div class="rating">
          ⭐ ${player[2]}
        </div>

        <div class="small">
          ${player[1]}
        </div>

      </div>

    `;

  });

}

function openAuction(){

  document.getElementById("menu").style.display="none";
  document.getElementById("auctionMenu").style.display="block";

  const box = document.getElementById("auctionCards");

  box.innerHTML="";

  auctionPlayers.forEach((player,index)=>{

    box.innerHTML += `

      <div class="card">

        <h3>${player[0]}</h3>

        <p>${player[1]}</p>

        <p>Base: ₹${player[2]} Cr</p>

        <button onclick="buyPlayer(${index})">
          BID
        </button>

      </div>

    `;

  });

}

function openCareer(){

  document.getElementById("menu").style.display="none";
  document.getElementById("careerMenu").style.display="block";

}


/* ================= SELECTION ================= */

function selectStadium(name){

  selectedStadium = name;

  alert(
    "Selected Stadium:\\n\\n" +
    selectedStadium +
    "\\n\\nHigh-quality 3D stadium will load in the match."
  );

  closePanels();

}

function chooseTeam(team){

  selectedTeam = team;

  alert(team + " selected.");

  closePanels();

}

function buyPlayer(index){

  const price = auctionPlayers[index][2];

  let purse =
    Number(document.getElementById("purse").textContent);

  if(purse >= price){

    purse -= price;

    document.getElementById("purse").textContent =
      purse;

    alert(
      auctionPlayers[index][0] +
      " purchased for ₹" +
      price +
      " Cr!"
    );

  }else{

    alert("Not enough purse!");

  }

}


/* =========================================================
   THREE.JS 3D STADIUM
========================================================= */

let scene;
let renderer;
let gameCamera;

let batter;
let bowler;
let wicketkeeper;
let umpire;

let ball;

let animationTime = 0;

const threeContainer =
  document.getElementById("three");


function createPlayer(x,z,shirt){

  const group = new THREE.Group();

  const body =
    new THREE.Mesh(
      new THREE.CapsuleGeometry(.28,.65,6,12),
      new THREE.MeshStandardMaterial({
        color:shirt,
        roughness:.7
      })
    );

  body.position.y=.75;

  group.add(body);

  const head =
    new THREE.Mesh(
      new THREE.SphereGeometry(.22,16,16),
      new THREE.MeshStandardMaterial({
        color:0xc98e65,
        roughness:.8
      })
    );

  head.position.y=1.35;

  group.add(head);

  const leg1 =
    new THREE.Mesh(
      new THREE.CylinderGeometry(.07,.09,.55,8),
      new THREE.MeshStandardMaterial({
        color:0x101820
      })
    );

  leg1.position.set(-.11,.28,0);

  group.add(leg1);

  const leg2 =
    leg1.clone();

  leg2.position.x=.11;

  group.add(leg2);

  group.position.set(x,0,z);

  scene.add(group);

  return group;

}


function createStadium(){

  scene =
    new THREE.Scene();

  scene.background =
    new THREE.Color(0x06111b);


  /* LIGHT */

  const ambient =
    new THREE.HemisphereLight(
      0xb9e6ff,
      0x111522,
      2.2
    );

  scene.add(ambient);


  const mainLight =
    new THREE.DirectionalLight(
      0xffffff,
      3
    );

  mainLight.position.set(
    10,
    20,
    10
  );

  scene.add(mainLight);


  /* GROUND */

  const ground =
    new THREE.Mesh(
      new THREE.CircleGeometry(
        16,
        96
      ),
      new THREE.MeshStandardMaterial({
        color:0x176d38,
        roughness:.9
      })
    );

  ground.rotation.x =
    -Math.PI/2;

  scene.add(ground);


  /* PITCH */

  const pitch =
    new THREE.Mesh(
      new THREE.BoxGeometry(
        2.8,
        .08,
        22
      ),
      new THREE.MeshStandardMaterial({
        color:0xc7a96b,
        roughness:.8
      })
    );

  pitch.position.y=.05;

  scene.add(pitch);


  /* CREASE */

  for(let z of [-9,-7.8,7.8,9]){

    const line =
      new THREE.Mesh(
        new THREE.BoxGeometry(
          2.5,
          .02,
          .04
        ),
        new THREE.Mesh
