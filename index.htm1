<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>RJ Game India 1.1.0</title>
<link rel="manifest" href="./manifest.webmanifest">

<style>
*{box-sizing:border-box}
html,body{
 margin:0;width:100%;height:100%;overflow:hidden;
 background:#02050a;color:#fff;
 font-family:Arial,sans-serif
}
button{
 border:1px solid #4384ad;
 background:linear-gradient(145deg,#153652,#07101a);
 color:#fff;border-radius:12px;
 padding:11px 14px;margin:4px;
 font-weight:800
}
button:active{transform:scale(.94)}

#loading{
 position:fixed;inset:0;z-index:99;
 display:flex;align-items:center;justify-content:center;
 text-align:center;
 background:
 radial-gradient(circle at 50% 25%,#174b75,#02050a 68%)
}
.loadBox{width:min(92vw,650px)}
.logo{
 font-size:clamp(38px,9vw,72px);
 font-weight:1000;letter-spacing:3px;
 text-shadow:0 0 25px #18a8ff
}
.loadImg{
 width:min(90vw,460px);
 max-height:42vh;object-fit:contain;
 border-radius:20px;margin:15px 0;
 box-shadow:0 0 35px #008cff77
}
.track{
 height:14px;background:#101c28;
 border-radius:20px;overflow:hidden
}
#bar{
 width:0;height:100%;
 background:linear-gradient(90deg,#00aaff,#fff,#00aaff);
 box-shadow:0 0 20px #00aaff
}
#app{display:none;position:fixed;inset:0}

#home{
 position:absolute;inset:0;overflow:auto;
 padding:18px;
 background:
 radial-gradient(circle at 50% 0,#16486e,#02060b 70%)
}
h1{text-align:center;margin:5px 0}
.tag{text-align:center;color:#a8ddff}
.grid{
 max-width:900px;margin:25px auto;
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
 gap:12px
}
.card{
 background:linear-gradient(145deg,#10263a,#050b12);
 border:1px solid #285575;
 border-radius:18px;padding:18px;
 text-align:center;
 box-shadow:0 10px 25px #0009
}
.menu{
 min-height:105px;
 display:flex;align-items:center;justify-content:center;
 cursor:pointer;font-size:17px;font-weight:900
}

.panel{
 position:absolute;inset:0;z-index:30;
 display:none;overflow:auto;padding:20px;
 background:#03070d
}
.panelBox{
 max-width:950px;margin:auto;
 background:linear-gradient(145deg,#102336,#04080d);
 border:1px solid #2d6080;
 border-radius:20px;padding:18px
}
.stadiums,.players{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
 gap:12px
}
.stadium{
 height:120px;border-radius:14px;
 position:relative;overflow:hidden;
 background:
 radial-gradient(ellipse at center,#0d913f 0 25%,#d1b775 26% 31%,#188148 32% 48%,#263b4e 49% 67%,#070b10 68%)
}
.stadium:after{
 content:"";
 position:absolute;inset:0;
 background:repeating-linear-gradient(
  90deg,transparent 0 8px,#ffffff18 9px 10px
 )
}

.playerFace{
 width:82px;height:82px;border-radius:50%;
 object-fit:cover;
 border:2px solid #56bfff;
 margin:auto;
 background:
 radial-gradient(circle at 50% 33%,#d39a70 0 27%,transparent 28%),
 linear-gradient(#182d43 0 52%,#0b1117 53%)
}

#game{
 display:none;position:absolute;inset:0;
 background:#020509
}
#world{position:absolute;inset:0}
#hud{
 position:absolute;top:7px;left:7px;right:7px;
 display:flex;justify-content:space-between;
 z-index:10;pointer-events:none
}
.hud{
 background:#020712d9;
 border:1px solid #4c87a8;
 border-radius:12px;padding:8px 11px;
 backdrop-filter:blur(7px);
 font-weight:900
}
.small{font-size:11px;color:#a6c4d5}

#commentary{
 position:absolute;z-index:11;
 left:50%;transform:translateX(-50%);
 bottom:112px;
 width:min(92vw,650px);
 padding:9px 14px;
 text-align:center;
 border-radius:14px;
 background:#02060cd9;
 border:1px solid #4784a5;
 font-weight:800
}
#controls{
 position:absolute;left:0;right:0;bottom:5px;
 z-index:15;text-align:center
}
#controls button{font-size:11px;min-width:70px}

#replay{
 display:none;position:absolute;
 right:8px;top:70px;z-index:20;
 background:#02060de8;
 padding:10px;border-radius:14px;
 border:1px solid #4b91ba
}

#shotCanvas{
 position:absolute;inset:0;
 z-index:8;pointer-events:none
}
</style>
</head>

<body>

<div id="loading">
 <div class="loadBox">
  <div class="logo">RJ GAME INDIA</div>
  <div class="tag">3D CRICKET • VERSION 1.1.0</div>

  <img class="loadImg"
       src="./virat-kohli.png"
       onerror="this.style.display='none'">

  <div class="track"><div id="bar"></div></div>
  <div id="pct">0%</div>
  <p class="small">
   3D Stadium • Playing XI • IPL • Career • Replay • Weather
  </p>
 </div>
</div>

<div id="app">

<section id="home">

 <h1>🏏 RJ GAME INDIA</h1>
 <div class="tag">
  HIGH QUALITY 3D CRICKET • v1.1.0
 </div>

 <div class="grid">

  <div class="card menu" onclick="openPanel('stadiumPanel')">
   🏟️<br>STADIUM
  </div>

  <div class="card menu" onclick="openTeams()">
   🌍<br>TEAMS
  </div>

  <div class="card menu" onclick="openXI()">
   👥<br>PLAYING XI
  </div>

  <div class="card menu" onclick="startGame()">
   🏏<br>PLAY MATCH
  </div>

  <div class="card menu" onclick="openPanel('auctionPanel')">
   💰<br>IPL AUCTION
  </div>

  <div class="card menu" onclick="openPanel('careerPanel')">
   🏆<br>CAREER MODE
  </div>

  <div class="card menu" onclick="alert('POWER SHOT • SWING • DEFEND • RUN • BOWL')">
   🎮<br>CONTROLS
  </div>

  <div class="card menu" onclick="alert('Hindi live commentary ON')">
   🎙️<br>COMMENTARY
  </div>

 </div>

 <div class="card">
  <b>FEATURES</b>
  <p class="small">
   3D Players • 3D Stadium • Animated Crowd • Floodlights •
   Shot Tracer • Replay • Broadcast Camera • Weather •
   IPL Auction • Career • Strong AI Framework
  </p>
 </div>

</section>


<!-- STADIUM -->

<section id="stadiumPanel" class="panel">
 <div class="panelBox">
  <button onclick="closePanels()">← BACK</button>
  <h2>🏟️ SELECT STADIUM</h2>

  <div class="stadiums">

   <div class="card" onclick="selectStadium('Wankhede Stadium')">
    <div class="stadium"></div>
    <b>Wankhede Stadium</b>
    <p class="small">Mumbai</p>
   </div>

   <div class="card" onclick="selectStadium('M. Chinnaswamy Stadium')">
    <div class="stadium"></div>
    <b>M. Chinnaswamy Stadium</b>
    <p class="small">Bengaluru</p>
   </div>

   <div class="card" onclick="selectStadium('Arun Jaitley Stadium')">
    <div class="stadium"></div>
    <b>Arun Jaitley Stadium</b>
    <p class="small">Delhi</p>
   </div>

   <div class="card" onclick="selectStadium('Perth Stadium')">
    <div class="stadium"></div>
    <b>Perth Stadium</b>
    <p class="small">Perth</p>
   </div>

  </div>
 </div>
</section>


<!-- TEAMS -->

<section id="teamPanel" class="panel">
 <div class="panelBox">
  <button onclick="closePanels()">← BACK</button>
  <h2>🌍 INTERNATIONAL TEAMS</h2>
  <div class="players" id="teams"></div>
 </div>
</section>


<!-- XI -->

<section id="xiPanel" class="panel">
 <div class="panelBox">
  <button onclick="closePanels()">← BACK</button>
  <h2>🇮🇳 INDIA PLAYING XI</h2>
  <div class="players" id="xi"></div>
 </div>
</section>


<!-- AUCTION -->

<section id="auctionPanel" class="panel">
 <div class="panelBox">
  <button onclick="closePanels()">← BACK</button>
  <h2>💰 IPL AUCTION</h2>
  <p>Team Purse: ₹<b id="purse">100</b> Cr</p>
  <div class="players" id="auction"></div>
 </div>
</section>


<!-- CAREER -->

<section id="careerPanel" class="panel">
 <div class="panelBox">
  <button onclick="closePanels()">← BACK</button>
  <h2>🏆 CAREER MODE</h2>
  <div class="card">
   <h3>RJ Career Player</h3>
   <p>Matches: 0</p>
   <p>Runs: 0</p>
   <p>Wickets: 0</p>
   <p>Rating: ⭐ 80</p>
   <button onclick="alert('Career Match Started!')">
    START CAREER
   </button>
  </div>
 </div>
</section>


<!-- GAME -->

<section id="game">

 <div id="world"></div>
 <canvas id="shotCanvas"></canvas>

 <div id="hud">
  <div class="hud">
   <div id="score">IND 0/0</div>
   <div class="small" id="overs">0.0 OVERS</div>
  </div>

  <div class="hud">
   <div id="stadiumTitle">Wankhede Stadium</div>
   <div class="small" id="weather">☀️ CLEAR</div>
  </div>
 </div>

 <div id="commentary">
  🎙️ RJ Game India Live Commentary
 </div>

 <div id="replay">
  <b>🎥 CAMERA</b><br>
  <button onclick="camera('broadcast')">BROADCAST</button>
  <button onclick="camera('bat')">BATTER</button>
  <button onclick="camera('bowl')">BOWLER</button>
  <button onclick="camera('ball')">BALL</button>
 </div>

 <div id="controls">
  <button onclick="shot('POWER')">POWER SHOT</button>
  <button onclick="shot('SWING')">SWING</button>
  <button onclick="shot('DEFEND')">DEFEND</button>
  <button onclick="run()">RUN</button>
  <button onclick="bowl()">BOWL</button>
  <button onclick="replay()">REPLAY</button>
  <button onclick="weather()">WEATHER</button>
  <button onclick="cycleCamera()">CAMERA</button>
  <button onclick="exitGame()">MENU</button>
 </div>

</section>

</div>


<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<script>

/* ================= DATA ================= */

let stadiumName="Wankhede Stadium";
let team="India";

let score=0;
let wickets=0;
let deliveries=0;

const teams=[
 "India","Australia","England","Pakistan",
 "South Africa","New Zealand","Sri Lanka",
 "Bangladesh","Afghanistan","West Indies",
 "Zimbabwe","Ireland"
];

const XI=[
 ["Rohit Sharma","BAT",90],
 ["Shubman Gill","BAT",89],
 ["Virat Kohli","BAT",96,"./virat-kohli.png"],
 ["Shreyas Iyer","BAT",87],
 ["KL Rahul","WK-BAT",88],
 ["Ravindra Jadeja","AR",91],
 ["Hardik Pandya","AR",90],
 ["Jasprit Bumrah","BOWL",97],
 ["Kuldeep Yadav","BOWL",88],
 ["Mohammed Siraj","BOWL",86],
 ["Arshdeep Singh","BOWL",85]
];

const auction=[
 ["Virat Kohli","RCB",18],
 ["Rohit Sharma","MI",16],
 ["Jasprit Bumrah","MI",18],
 ["Ravindra Jadeja","RR",14],
 ["Hardik Pandya","MI",15],
 ["KL Rahul","DC",14],
 ["Shubman Gill","GT",14],
 ["Rishabh Pant","LSG",16],
 ["Suryakumar Yadav","MI",15],
 ["Yashasvi Jaiswal","RR",14]
];


/* ================= LOADING ================= */

let lp=0;

const lt=setInterval(()=>{
 lp++;
 bar.style.width=lp+"%";
 pct.textContent=lp+"%";

 if(lp>=100){
  clearInterval(lt);
  setTimeout(()=>{
   loading.style.display="none";
   app.style.display="block";
  },500);
 }
},20);


/* ================= PANELS ================= */

function openPanel(id){
 document.getElementById(id).style.display="block";
 home.style.display="none";
}

function closePanels(){
 document.querySelectorAll(".panel")
  .forEach(x=>x.style.display="none");
 home.style.display="block";
}

function openTeams(){
 openPanel("teamPanel");

 teams.innerHTML=teamsData();

}

function teamsData(){
 return teams.map(x=>`
  <div class="card">
   <h3>${x}</h3>
   <p class="small">International Team</p>
   <button onclick="selectTeam('${x}')">SELECT</button>
  </div>
 `).join("");
}

function selectTeam(x){
 team=x;
 alert(x+" selected");
 closePanels();
}

function openXI(){
 openPanel("xiPanel");

 xi.innerHTML=XI.map(p=>`
  <div class="card">
   ${
    p[3]
    ? `<img class="playerFace" src="${p[3]}">`
    : `<div class="playerFace"></div>`
   }
   <h3>${p[0]}</h3>
   <b>⭐ ${p[2]}</b>
   <p class="small">${p[1]}</p>
  </div>
 `).join("");
}

auction.innerHTML=auction.map((p,i)=>`
 <div class="card">
  <h3>${p[0]}</h3>
  <p>${p[1]}</p>
  <p>Base ₹${p[2]} Cr</p>
  <button onclick="bid(${i})">BID</button>
 </div>
`).join("");

function bid(i){
 let money=Number(purse.textContent);
 let price=auctionPlayers[i][2];

 if(money>=price){
  purse.textContent=money-price;
  alert(auctionPlayers[i][0]+" bought!");
 }else{
  alert("Purse insufficient!");
 }
}

const auctionPlayers=auction;


/* ================= STADIUM ================= */

function selectStadium(x){
 stadiumName=x;
 alert(x+" selected");
 closePanels();
}


/* ================= THREE 3D ================= */

let scene,renderer,cam;
let ball3d,batter3d,bowler3d;
let mixerTime=0;

function player3D(x,z,jersey){

 const g=new THREE.Group();

 const mat=new THREE.MeshStandardMaterial({
  color:jersey,
  roughness:.65
 });

 const skin=new THREE.MeshStandardMaterial({
  color:0xc98b63,
  roughness:.8
 });

 /* BODY */

 const body=new THREE.Mesh(
  new THREE.CapsuleGeometry(.28,.62,8,16),
  mat
 );

 body.position.y=.82;
 g.add(body);

 /* HEAD */

 const head=new THREE.Mesh(
  new THREE.SphereGeometry(.22,24,24),
  skin
 );

 head.position.y=1.42;
 g.add(head);

 /* ARMS */

 const arm1=new THREE.Mesh(
  new THREE.CylinderGeometry(.065,.08,.55,12),
  skin
 );

 arm1.position.set(-.36,.86,0);
 arm1.rotation.z=-.35;
 g.add(arm1);

 const arm2=arm1.clone();
 arm2.position.x=.36;
 arm2.rotation.z=.35;
 g.add(arm2);

 /* LEGS */

 const legMat=new THREE.MeshStandardMaterial({
  color:0x151b23
 });

 const leg1=new THREE.Mesh(
  new THREE.CylinderGeometry(.08,.1,.58,12),
  legMat
 );

 leg1.position.set(-.12,.28,0);
 g.add(leg1);

 const leg2=leg1.clone();
 leg2.position.x=.12;
 g.add(leg2);

 /* SHOES */

 const shoeMat=new THREE.MeshStandardMaterial({
  color:0xeeeeee
 });

 const shoe1=new THREE.Mesh(
  new THREE.BoxGeometry(.18,.09,.30),
  shoeMat
 );

 shoe1.position.set(-.12,.02,.07);
 g.add(shoe1);

 const shoe2=shoe1.clone();
 shoe2.position.x=.12;
 g.add(shoe2);

 g.position.set(x,0,z);

 scene.add(g);

 return g;
}


function makeBat(){

 const bat=new THREE.Group();

 const handle=new THREE.Mesh(
  new THREE.CylinderGeometry(.045,.055,.45,12),
  new THREE.MeshStandardMaterial({
   color:0x5a351d
  })
 );

 handle.position.y=.35;
 bat.add(handle);

 const blade=new THREE.Mesh(
  new THREE.BoxGeometry(.18,.8,.08),
  new THREE.MeshStandardMaterial({
   color:0xd5a45c,
   roughness:.7
  })
 );

 blade.position.y=.9;
 bat.add(blade);

 bat.rotation.z=-.25;

 return bat;
}


function createWorld(){

 scene=new THREE.Scene();

 scene.background=new THREE.Color(0x07121c);

 /* LIGHTING */

 const hemi=new THREE.HemisphereLight(
  0xbbeaff,
  0x101522,
  2.4
 );

 scene.add(hemi);

 const sun=new THREE.DirectionalLight(
  0xffffff,3.2
 );

 sun.position.set(8,20,10);
 scene.add(sun);


 /* FIELD */

 const field=new THREE.Mesh(
  new THREE.CircleGeometry(17,128),
  new THREE.MeshStandardMaterial({
   color:0x16753d,
   roughness:.92
  })
 );

 field.rotation.x=-Math.PI/2;
 scene.add(field);


 /* PITCH */

 const pitch=new THREE.Mesh(
  new THREE.BoxGeometry(2.8,.12,22),
  new THREE.MeshStandardMaterial({
   color:0xc9ac72,
   roughness:.85
  })
 );

 pitch.position.y=.06;
 scene.add(pitch);


 /* PITCH LINES */

 [-9,-7.8,7.8,9].forEach(z=>{

  const line=new THREE.Mesh(
   new THREE.BoxGeometry(2.5,.025,.035),
   new THREE.MeshBasicMaterial({
    color:0xffffff
   })
  );

  line.position.set(0,.13,z);
  scene.add(line);

 });


 /* STANDS */

 for(let r=0;r<4;r++){

  const stand=new THREE.Mesh(
   new THREE.TorusGeometry(
    14+r*1.7,
    1.0,
    10,
    128
   ),
   new THREE.MeshStandardMaterial({
    color:0x243849,
    roughness:.85
   })
  );

  stand.rotation.x=Math.PI/2;
  stand.position.y=1.3+r*.65;
  scene.add(stand);

 }


 /* CROWD */

 for(let i=0;i<600;i++){

  const a=Math.random()*Math.PI*2;
  const r=15+Math.random()*5;

  const person=new THREE.Mesh(
   new THREE.BoxGeometry(.10,.20,.10),
   new THREE.MeshStandardMaterial({
    color:
     Math.random()>.5
     ? 0xe5e5e5
     : 0x4f89ad
   })
  );

  person.position.set(
   Math.cos(a)*r,
   2+Math.random()*2.7,
   Math.sin(a)*r
  );

  scene.add(person);
 }


 /* FLOODLIGHTS */

 for(let i=0;i<4;i++){

  const a=i*Math.PI/2;

  const pole=new THREE.Mesh(
   new THREE.CylinderGeometry(.08,.12,7,12),
   new THREE.MeshStandardMaterial({
    color:0x777777
   })
  );

  pole.position.set(
   Math.cos(a)*11,
   3.5,
   Math.sin(a)*11
  );

  scene.add(pole);

  const light=new THREE.PointLight(
   0xffffff,
   5,
   22
  );

  light.position.set(
   Math.cos(a)*11,
   7,
   Math.sin(a)*11
  );

  scene.add(light);
 }


 /* PLAYERS */

 batter3d=player3D(
  0,8.2,0x174fa8
 );

 bowler3d=player3D(
  0,-5,0x174fa8
 );

 player3D(
  0,9.2,0x174fa8
 );

 player3D(
  3,8.7,0x151515
 );


 /* FIELDERS */

 for(let i=0;i<8;i++){

  const a=i/8*Math.PI*2;

  player3D(
   Math.cos(a)*8,
   Math.sin(a)*8,
   0x174fa8
  );

 }


 /* BAT */

 const bat=makeBat();

 bat.position.set(
  .30,.55,8.15
 );

 scene.add(bat);


 /* BALL */

 ball3d=new THREE.Mesh(
  new THREE.SphereGeometry(.10,24,24),
  new THREE.MeshStandardMaterial({
   color:0xffffff,
   roughness:.25
  })
 );

 ball3d.position.set(
  0,.35,-5
 );

 scene.add(ball3d);


 /* CAMERA */

 cam=new THREE.PerspectiveCamera(
  52,
  innerWidth/innerHeight,
  .1,
  100
 );

 cam.position.set(
  10,7.5,14
 );

 cam.lookAt(0,1,0);


 renderer=new THREE.WebGLRenderer({
  antialias:true,
  powerPreference:"high-performance"
 });

 renderer.setPixelRatio(
  Math.min(devicePixelRatio,2)
 );

 renderer.setSize(
  innerWidth,
  innerHeight
 );

 world.innerHTML="";
 world.appendChild(renderer.domElement);

 addEventListener("resize",resize3d);

 animate();

}


function resize3d(){

 if(!renderer)return;

 cam.aspect=innerWidth/innerHeight;
 cam.updateProjectionMatrix();

 renderer.setSize(
  innerWidth,
  innerHeight
 );
}


function animate(){

 requestAnimationFrame(animate);

 mixerTime+=.025;

 if(batter3d){
  batter3d.rotation.y=
   Math.sin(mixerTime)*.04;
 }

 if(bowler3d){
  bowler3d.rotation.y=
   Math.sin(mixerTime*.8)*.03;
 }

 if(ball3d){
  ball3d.rotation.x+=.08;
  ball3d.rotation.y+=.05;
 }

 renderer.render(scene,cam);

}


/* ================= MATCH ================= */

function startGame(){

 home.style.display="none";
 game.style.display="block";

 score=0;
 wickets=0;
 deliveries=0;

 stadiumTitle.textContent=stadiumName;
 updateScore();

 createWorld();

 say(
  "🏏 "+team+
  " batting at "+stadiumName+
  ". Match शुरू!"
 );

}

function updateScore(){

 document.getElementById("score").textContent=
  team.substring(0,3).toUpperCase()+
  " "+score+"/"+wickets;

 document.getElementById("overs").textContent=
  Math.floor(deliveries/6)+"."+
  deliveries%6+" OVERS";

}


/* ================= SHOTS ================= */

function shot(type){

 deliveries++;

 let r=0;

 if(type==="POWER"){
  r=[4,6,6,4,2][
   Math.floor(Math.random()*5)
  ];
 }
 else if(type==="SWING"){
  r=[0,1,2,3,4,6][
   Math.floor(Math.random()*6)
  ];
 }
 else{
  r=Math.random()>.8?0:1;
 }

 if(Math.random()<.07){

  wickets++;

  say("🔥 OUT! शानदार bowling!");

 }else{

  score+=r;

  if(r===6)
   say("🚀 SIX! क्या शानदार POWER SHOT!");

  else if(r===4)
   say("🔥 FOUR! Boundary के पार!");

  else if(r===0)
   say("🛡️ शानदार defence. Dot ball!");

  else
   say("🏏 "+r+" run!");

 }

 updateScore();
 tracer(r);

}


function run(){

 deliveries++;
 score++;

 updateScore();

 say("🏃 Quick single! शानदार running.");

}


/* ================= BOWL ================= */

function bowl(){

 deliveries++;

 if(Math.random()<.14){

  wickets++;

  say(
   "🎯 WICKET! Bumrah-style Yorker!"
  );

 }else{

  const r=[0,1,2,4][
   Math.floor(Math.random()*4)
  ];

  score+=r;

  say("🎙️ गेंद डाली गई — "+r+" run.");

 }

 updateScore();
 animateBall();

}


function animateBall(){

 if(!ball3d)return;

 let t=0;

 const timer=setInterval(()=>{

  t+=.045;

  ball3d.position.z=
   -5+13*t;

  ball3d.position.y=
   .35+Math.sin(t*Math.PI)*1.5;

  if(t>=1){

   clearInterval(timer);

   ball3d.position.set(
    0,.35,-5
   );

  }

 },25);

}


/* ================= TRACER ================= */

function tracer(r){

 if(r===0)return;

 const c=document.getElementById("shotCanvas");
 const x=c.getContext("2d");

 c.width=innerWidth;
 c.height=innerHeight;

 let p=0;

 const sx=c.width/2;
 const sy=c.height*.62;

 const ex=
  sx+(Math.random()-.5)*c.width*.72;

 const ey=
  sy-Math.random()*c.height*.48;

 const timer=setInterval(()=>{

  p+=.035;

  x.clearRect(
   0,0,c.width,c.height
  );

  x.beginPath();

  x.moveTo(sx,sy);

  x.lineTo(
   sx+(ex-sx)*p,
   sy+(ey-sy)*p
  );

  x.lineWidth=5;
  x.strokeStyle="white";
  x.shadowBlur=18;
  x.shadowColor="white";
  x.stroke();

  if(p>=1){

   clearInterval(timer);

   setTimeout(()=>{
    x.clearRect(
     0,0,c.width,c.height
    );
   },500);

  }

 },25);
